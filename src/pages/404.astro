---
export const prerender = false;

Astro.response.status = 404;
Astro.response.statusText = 'Not Found';

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = "https://extractyoutubescript.com/404";
const pageTitle = "Página Não Encontrada (404) — Extractyoutubescript";
const pageDescription = "A página que você tentou acessar não existe, foi removida ou o link está incorreto. Acesse o Extractyoutubescript para transcrever vídeos do YouTube em texto gratuitamente.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  noindex={true}
  pageType="website"
>
  <Header />

  <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 flex flex-col items-center justify-center">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="w-full mb-8 flex items-center justify-center gap-2 text-xs sm:text-sm text-[#6b7280]">
      <a href="/" class="hover:text-[#111111] transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span>Início</span>
      </a>
      <span class="text-gray-300">/</span>
      <span class="text-[#111111] font-semibold" aria-current="page">Erro 404</span>
    </nav>

    <!-- Error Hero Card -->
    <div class="w-full text-center max-w-2xl mx-auto">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-green-50 border border-green-200 text-green-700 text-xs sm:text-sm font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-green-600 animate-pulse" aria-hidden="true"></span>
        <span>Erro 404 • Página Não Encontrada</span>
      </div>

      <!-- Giant 404 Number -->
      <div class="text-8xl sm:text-9xl font-black tracking-tight text-[#111111] leading-none mb-4 select-none">
        404
      </div>

      <!-- Heading -->
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#111111] tracking-tight mb-4">
        Esta página não existe
      </h1>

      <!-- Subtitle description -->
      <p class="text-base sm:text-lg text-[#4b5563] leading-relaxed mb-8 sm:mb-10 max-w-xl mx-auto">
        O link digitado pode conter algum erro de digitação, a página pode ter mudado de endereço ou o conteúdo foi removido. Não se preocupe, você ainda pode transcrever seus vídeos!
      </p>

      <!-- Primary Action CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-14">
        <a
          href="/"
          class="w-full sm:w-auto min-h-[48px] px-6 py-3 rounded-xl bg-[#111111] hover:bg-[#262626] text-white font-bold text-sm sm:text-base transition-colors shadow-xs flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current text-red-500" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626 2.46 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
          </svg>
          <span>Ir para o Transcritor</span>
        </a>

        <a
          href="/#faq"
          class="w-full sm:w-auto min-h-[48px] px-6 py-3 rounded-xl bg-white hover:bg-gray-50 text-[#111111] border border-[#ebebeb] font-semibold text-sm sm:text-base transition-colors shadow-xs flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 text-[#6b7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Perguntas Frequentes</span>
        </a>

        <a
          href="/contact?topic=support"
          class="w-full sm:w-auto min-h-[48px] px-6 py-3 rounded-xl hover:bg-black/5 text-[#4b5563] hover:text-[#111111] font-semibold text-sm sm:text-base transition-colors flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 text-[#6b7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>Fale Conosco</span>
        </a>
      </div>
    </div>

    <!-- Helpful Quick Navigation Grid -->
    <section class="w-full border-t border-[#ebebeb] pt-12 sm:pt-16" aria-label="Links Úteis">
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#6b7280] text-center mb-6">
        Ou acesse uma das áreas principais
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1 -->
        <a
          href="/"
          class="group p-5 bg-white border border-[#ebebeb] hover:border-[#111111]/30 rounded-2xl shadow-xs transition-all hover:shadow-sm flex flex-col justify-between text-left"
        >
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-red-50 text-red-600 flex items-center justify-center">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626 2.46 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
              </svg>
            </div>
            <div class="font-bold text-sm sm:text-base text-[#111111] group-hover:text-red-600 transition-colors">
              Transcrever Vídeo
            </div>
            <p class="text-xs text-[#6b7280] leading-relaxed">
              Cole o link de qualquer vídeo público do YouTube para extrair o texto completo em instantes.
            </p>
          </div>
          <div class="pt-4 flex items-center gap-1 text-xs font-semibold text-[#111111] group-hover:translate-x-0.5 transition-transform">
            <span>Acessar ferramenta</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>

        <!-- Card 2 -->
        <a
          href="/about"
          class="group p-5 bg-white border border-[#ebebeb] hover:border-[#111111]/30 rounded-2xl shadow-xs transition-all hover:shadow-sm flex flex-col justify-between text-left"
        >
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="font-bold text-sm sm:text-base text-[#111111] group-hover:text-blue-600 transition-colors">
              Sobre Nós
            </div>
            <p class="text-xs text-[#6b7280] leading-relaxed">
              Conheça o propósito, a arquitetura técnica e os formatos suportados pelo projeto.
            </p>
          </div>
          <div class="pt-4 flex items-center gap-1 text-xs font-semibold text-[#111111] group-hover:translate-x-0.5 transition-transform">
            <span>Conhecer o projeto</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>

        <!-- Card 3 -->
        <a
          href="/contact"
          class="group p-5 bg-white border border-[#ebebeb] hover:border-[#111111]/30 rounded-2xl shadow-xs transition-all hover:shadow-sm flex flex-col justify-between text-left"
        >
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="font-bold text-sm sm:text-base text-[#111111] group-hover:text-emerald-600 transition-colors">
              Fale Conosco
            </div>
            <p class="text-xs text-[#6b7280] leading-relaxed">
              Envie sua dúvida, reporte um erro em vídeo ou proponha uma nova funcionalidade.
            </p>
          </div>
          <div class="pt-4 flex items-center gap-1 text-xs font-semibold text-[#111111] group-hover:translate-x-0.5 transition-transform">
            <span>Enviar mensagem</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>

        <!-- Card 4 -->
        <a
          href="/privacy-policy"
          class="group p-5 bg-white border border-[#ebebeb] hover:border-[#111111]/30 rounded-2xl shadow-xs transition-all hover:shadow-sm flex flex-col justify-between text-left"
        >
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div class="font-bold text-sm sm:text-base text-[#111111] group-hover:text-purple-600 transition-colors">
              Privacidade & Termos
            </div>
            <p class="text-xs text-[#6b7280] leading-relaxed">
              Consulte nossa política de conformidade LGPD/GDPR e termos de utilização transparente.
            </p>
          </div>
          <div class="pt-4 flex items-center gap-1 text-xs font-semibold text-[#111111] group-hover:translate-x-0.5 transition-transform">
            <span>Ver políticas</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
