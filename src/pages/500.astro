---
export const prerender = false;

interface Props {
  error?: unknown;
}

const { error } = Astro.props;

Astro.response.status = 500;
Astro.response.statusText = 'Internal Server Error';

const isDev = import.meta.env.DEV;
const errorMessage = error instanceof Error
  ? error.message
  : typeof error === 'string'
    ? error
    : 'Erro inesperado no servidor.';

const incidentId = `INC-${Date.now().toString(36).toUpperCase()}-${Math.random().toString(36).substring(2, 7).toUpperCase()}`;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = "https://extractyoutubescript.com/500";
const pageTitle = "Erro Interno no Servidor (500) — Extractyoutubescript";
const pageDescription = "Ocorreu uma instabilidade temporária em nossos servidores. Nossa equipe já está trabalhando para normalizar. Tente novamente ou volte à página inicial.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  noindex={true}
  pageType="website"
>
  <Header />

  <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 flex flex-col items-center justify-center">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="w-full mb-8 flex items-center justify-center gap-2 text-xs sm:text-sm text-[#6b7280]">
      <a href="/" class="hover:text-[#111111] transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span>Início</span>
      </a>
      <span class="text-gray-300">/</span>
      <span class="text-[#111111] font-semibold" aria-current="page">Erro 500</span>
    </nav>

    <!-- Error Hero Card -->
    <div class="w-full text-center max-w-2xl mx-auto">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-xs sm:text-sm font-semibold mb-6">
        <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <span>Erro 500 • Instabilidade no Servidor</span>
      </div>

      <!-- Giant 500 Number -->
      <div class="text-7xl sm:text-9xl font-black tracking-tight text-[#111111] leading-none mb-4 select-none">
        500
      </div>

      <!-- Heading -->
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#111111] tracking-tight mb-4">
        Algo deu errado por aqui
      </h1>

      <!-- Subtitle description -->
      <p class="text-base sm:text-lg text-[#4b5563] leading-relaxed mb-6 max-w-xl mx-auto">
        Ocorreu uma falha temporária em nossos servidores enquanto processávamos sua solicitação. Nenhum dado pessoal foi comprometido e nossa equipe monitora o sistema para restabelecer a estabilidade.
      </p>

      <!-- Incident ID Box with Copy Action -->
      <div class="inline-flex items-center gap-2 sm:gap-3 px-4 py-2 rounded-xl bg-white border border-[#ebebeb] text-xs sm:text-sm text-[#4b5563] mb-8 shadow-xs">
        <span class="font-semibold text-[#111111]">Código do Incidente:</span>
        <code class="font-mono font-bold text-red-600 select-all" id="incident-code">{incidentId}</code>
        <button
          type="button"
          id="copy-incident-btn"
          title="Copiar código do incidente"
          class="p-1 rounded-md text-gray-400 hover:text-[#111111] hover:bg-gray-100 transition-colors cursor-pointer"
          aria-label="Copiar código do incidente"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
        </button>
      </div>

      <!-- Dev Details (Only in development) -->
      {isDev && (
        <details class="max-w-2xl mx-auto mb-8 text-left bg-red-50/80 border border-red-200 rounded-2xl p-4 sm:p-5 shadow-xs">
          <summary class="cursor-pointer text-xs sm:text-sm font-bold text-red-900 select-none flex items-center gap-2">
            <svg class="w-4 h-4 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
            <span>Ver detalhes técnicos (Ambiente de Desenvolvimento)</span>
          </summary>
          <div class="mt-3 p-3 bg-white/90 rounded-xl border border-red-100 font-mono text-xs text-red-800 break-all overflow-x-auto whitespace-pre-wrap">
            <p class="font-bold mb-1">{errorMessage}</p>
            {error instanceof Error && error.stack && (
              <div class="mt-2 pt-2 border-t border-red-100 text-[11px] text-red-700 font-mono">
                {error.stack}
              </div>
            )}
          </div>
        </details>
      )}

      <!-- Primary Action CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-14">
        <button
          type="button"
          onclick="window.location.reload()"
          class="w-full sm:w-auto min-h-[48px] px-6 py-3 rounded-xl bg-[#111111] hover:bg-[#262626] text-white font-bold text-sm sm:text-base transition-colors shadow-xs flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          <span>Tentar Novamente</span>
        </button>

        <a
          href="/"
          class="w-full sm:w-auto min-h-[48px] px-6 py-3 rounded-xl bg-white hover:bg-gray-50 text-[#111111] border border-[#ebebeb] font-semibold text-sm sm:text-base transition-colors shadow-xs flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 text-[#6b7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span>Voltar ao Início</span>
        </a>

        <a
          href={`/contact?topic=support&ref=${encodeURIComponent(incidentId)}`}
          class="w-full sm:w-auto min-h-[48px] px-6 py-3 rounded-xl hover:bg-black/5 text-[#4b5563] hover:text-[#111111] font-semibold text-sm sm:text-base transition-colors flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 text-[#6b7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>Relatar Problema</span>
        </a>
      </div>
    </div>

    <!-- Troubleshooting Steps Guide -->
    <section class="w-full border-t border-[#ebebeb] pt-12 sm:pt-16" aria-label="Etapas Recomendadas">
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#6b7280] text-center mb-6">
        O que você pode fazer agora?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Step 1 -->
        <div class="p-5 bg-white border border-[#ebebeb] rounded-2xl shadow-xs space-y-2">
          <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 font-bold text-xs flex items-center justify-center">
            01
          </div>
          <h3 class="font-bold text-sm sm:text-base text-[#111111]">
            Aguarde e Recarregue
          </h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Muitas vezes trata-se de um atraso temporário na resposta das APIs de legendas do YouTube. Aguarde alguns segundos e clique em <em>Tentar Novamente</em>.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-5 bg-white border border-[#ebebeb] rounded-2xl shadow-xs space-y-2">
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 font-bold text-xs flex items-center justify-center">
            02
          </div>
          <h3 class="font-bold text-sm sm:text-base text-[#111111]">
            Verifique o Link do Vídeo
          </h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Certifique-se de que o vídeo do YouTube não é privado, não possui bloqueio geográfico estrito ou restrição de idade (18+), que podem impedir o acesso público.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-5 bg-white border border-[#ebebeb] rounded-2xl shadow-xs space-y-2">
          <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 font-bold text-xs flex items-center justify-center">
            03
          </div>
          <h3 class="font-bold text-sm sm:text-base text-[#111111]">
            Envie o Código do Incidente
          </h3>
          <p class="text-xs text-[#6b7280] leading-relaxed">
            Se a falha persistir após recarregar, abra nossa página de contato e envie o código informado acima junto com o link do vídeo para que nossa equipe examine os logs.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const copyBtn = document.getElementById('copy-incident-btn');
  const codeEl = document.getElementById('incident-code');

  if (copyBtn && codeEl) {
    copyBtn.addEventListener('click', async () => {
      const code = codeEl.textContent?.trim() || '';
      try {
        await navigator.clipboard.writeText(code);
        copyBtn.innerHTML = `
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        `;
        setTimeout(() => {
          copyBtn.innerHTML = `
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          `;
        }, 2000);
      } catch (e) {
        // Fallback
      }
    });
  }
</script>
