---
import BrandLogo from './BrandLogo.astro';
---

<footer class="mt-auto border-t border-[#ebebeb] bg-[#fafafa] py-10 sm:py-14 px-3.5 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10 mb-10 sm:mb-12">
      <!-- Col 1: Wordmark & Statement -->
      <div class="space-y-3.5 sm:col-span-2 lg:col-span-1">
        <BrandLogo size="sm" textClass="text-base sm:text-lg" />
        <p class="text-sm text-[#4b5563] leading-relaxed" data-i18n="footer.tagline">
          Ferramenta online gratuita e IA para transcrever vídeo do YouTube em texto com legendas automáticas, áudio fallback e exportação em múltiplos formatos.
        </p>
        <div class="flex flex-col gap-1.5 pt-1 text-xs text-[#666666]">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
            <span class="font-medium">100% Gratuito & Sem Cadastro</span>
          </div>
          <div class="text-[#6b7280]">
            extractyoutubescript.com
          </div>
        </div>
      </div>

      <!-- Col 2: Guia & Recursos -->
      <div class="space-y-3">
        <p class="text-xs sm:text-sm font-bold text-[#111111] uppercase tracking-wider" data-i18n="footer.methods_title">
          Guia & Ferramenta
        </p>
        <ul class="space-y-2 text-sm text-[#374151]">
          <li><a href="/#app" class="hover:text-[#111111] transition-colors" data-i18n="footer.m1">Transcrever Vídeo Agora</a></li>
          <li><a href="/#sobre" class="hover:text-[#111111] transition-colors">Como Transcrever Passo a Passo</a></li>
          <li><a href="/#sobre" class="hover:text-[#111111] transition-colors">IA para Vídeos Sem Legendas</a></li>
          <li><a href="/#faq" class="hover:text-[#111111] transition-colors">Perguntas Frequentes (FAQ)</a></li>
        </ul>
      </div>

      <!-- Col 3: Institucional -->
      <div class="space-y-3">
        <p class="text-xs sm:text-sm font-bold text-[#111111] uppercase tracking-wider" data-i18n="footer.company_title">
          Institucional
        </p>
        <ul class="space-y-2 text-sm text-[#374151]">
          <li><a href="/about" class="hover:text-[#111111] transition-colors" data-i18n="footer.about">Sobre Nós</a></li>
          <li><a href="/contact" class="hover:text-[#111111] transition-colors" data-i18n="footer.contact">Fale Conosco</a></li>
          <li><a href="/contact?topic=support" class="hover:text-[#111111] transition-colors">Suporte Técnico</a></li>
          <li><a href="/contact?topic=feature" class="hover:text-[#111111] transition-colors">Sugerir Funcionalidade</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Políticas -->
      <div class="space-y-3">
        <p class="text-xs sm:text-sm font-bold text-[#111111] uppercase tracking-wider" data-i18n="footer.legal_title">
          Legal & Privacidade
        </p>
        <ul class="space-y-2 text-sm text-[#374151]">
          <li><a href="/privacy-policy" class="hover:text-[#111111] transition-colors" data-i18n="footer.privacy">Política de Privacidade</a></li>
          <li><a href="/terms" class="hover:text-[#111111] transition-colors" data-i18n="footer.terms">Termos e Condições</a></li>
          <li><a href="/terms#disclaimer" class="hover:text-[#111111] transition-colors" data-i18n="footer.disclaimer">Aviso YouTube™</a></li>
          <li><a href="/privacy-policy#compliance" class="hover:text-[#111111] transition-colors">Conformidade LGPD & GDPR</a></li>
        </ul>
      </div>
    </div>

    <!-- Sub-footer copyright & bottom links -->
    <div class="pt-8 border-t border-[#ebebeb] flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#6b7280]">
      <p class="text-center md:text-left leading-relaxed">
        &copy; {new Date().getFullYear()} Extractyoutubescript. Todos os direitos reservados. Não somos afiliados, associados ou patrocinados pelo YouTube&trade; ou Google LLC.
      </p>
      <div class="flex items-center flex-wrap justify-center gap-4 text-xs font-medium text-[#4b5563]">
        <a href="/about" class="hover:text-[#111111] transition-colors" data-i18n="header.nav_about">Sobre Nós</a>
        <span>&bull;</span>
        <a href="/contact" class="hover:text-[#111111] transition-colors" data-i18n="header.nav_contact">Contato</a>
        <span>&bull;</span>
        <a href="/privacy-policy" class="hover:text-[#111111] transition-colors" data-i18n="header.nav_privacy">Privacidade</a>
        <span>&bull;</span>
        <a href="/terms" class="hover:text-[#111111] transition-colors" data-i18n="header.nav_terms">Termos</a>
      </div>
    </div>
  </div>
</footer>
