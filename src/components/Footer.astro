---
---

<footer class="mt-auto border-t border-[#ebebeb] bg-[#fafafa] py-8 sm:py-12 px-3.5 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-8 sm:mb-12">
      <!-- Col 1: Wordmark & Statement -->
      <div class="space-y-3.5 sm:col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-6 h-6 rounded bg-[#ff0000] flex items-center justify-center text-white text-xs font-bold shadow-xs shrink-0">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626 2.46 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
            </svg>
          </div>
          <span class="text-base sm:text-lg font-bold tracking-tight text-[#111111]" data-i18n="header.brand">Extractyoutubescript</span>
        </a>
        <p class="text-sm sm:text-base text-[#4b5563] leading-relaxed" data-i18n="footer.tagline">
          Ferramenta online gratuita e IA para transcrever vídeo do YouTube em texto com legendas automáticas, áudio fallback e exportação em múltiplos formatos.
        </p>
        <div class="flex items-center gap-2 pt-1 text-xs font-medium text-[#666666]">
          <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
          <span>extractyoutubescript.com</span>
        </div>
      </div>

      <!-- Col 2: Methods & Navegação -->
      <div class="space-y-3">
        <p class="text-xs sm:text-sm font-bold text-[#111111] uppercase tracking-wider" data-i18n="footer.methods_title">
          Guia & Recursos
        </p>
        <ul class="space-y-2 text-sm sm:text-base text-[#374151]">
          <li><a href="#app" class="hover:text-[#111111] transition-colors" data-i18n="footer.m1">Transcrever Vídeo Agora</a></li>
          <li><a href="#sobre" class="hover:text-[#111111] transition-colors">Como Transcrever Passo a Passo</a></li>
          <li><a href="#sobre" class="hover:text-[#111111] transition-colors">IA para Vídeos Sem Legendas</a></li>
          <li><a href="#sobre" class="hover:text-[#111111] transition-colors">Perguntas Frequentes (FAQ)</a></li>
        </ul>
      </div>

      <!-- Col 3: Export Formats -->
      <div class="space-y-3">
        <p class="text-xs sm:text-sm font-bold text-[#111111] uppercase tracking-wider" data-i18n="footer.exports_title">
          Export Formats
        </p>
        <ul class="space-y-2 text-sm sm:text-base text-[#374151]">
          <li><a href="#app" class="hover:text-[#111111] transition-colors" data-i18n="footer.e1">SubRip Subtitles (.SRT)</a></li>
          <li><a href="#app" class="hover:text-[#111111] transition-colors" data-i18n="footer.e2">WebVTT Subtitles (.VTT)</a></li>
          <li><a href="#app" class="hover:text-[#111111] transition-colors" data-i18n="footer.e3">Notion / Obsidian Markdown (.MD)</a></li>
          <li><a href="#app" class="hover:text-[#111111] transition-colors" data-i18n="footer.e4">Plain Text with Timestamps (.TXT)</a></li>
          <li><a href="#app" class="hover:text-[#111111] transition-colors" data-i18n="footer.e5">Structured JSON (.JSON)</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
