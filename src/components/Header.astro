---
import BrandLogo from './BrandLogo.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/', label: 'Início', i18nKey: 'header.nav_home', matchExact: true },
  { href: '/about', label: 'Sobre Nós', i18nKey: 'header.nav_about' },
  { href: '/contact', label: 'Contato', i18nKey: 'header.nav_contact' },
  { href: '/privacy-policy', label: 'Privacidade', i18nKey: 'header.nav_privacy' },
  { href: '/terms', label: 'Termos', i18nKey: 'header.nav_terms' }
];

const isActive = (item: { href: string; matchExact?: boolean }) => {
  if (item.matchExact) return pathname === '/';
  return pathname === item.href || pathname.startsWith(item.href + '/');
};
---

<header class="sticky top-0 z-50 w-full border-b border-[#ebebeb] bg-[#fafafa]/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
    <!-- Brand Wordmark -->
    <BrandLogo size="md" />

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-1.5" aria-label="Navegação Principal">
      {navItems.map((item) => {
        const active = isActive(item);
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-lg text-xs lg:text-sm transition-colors ${
              active
                ? 'bg-[#111111]/5 text-[#111111] font-semibold'
                : 'text-[#4b5563] hover:text-[#111111] hover:bg-[#111111]/5 font-medium'
            }`}
            aria-current={active ? 'page' : undefined}
            data-i18n={item.i18nKey}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Controls: Language Selector Dropdown & Mobile Toggle -->
    <div class="flex items-center gap-2 shrink-0">
      <div class="relative flex items-center group">
        <label for="site-lang-select" class="sr-only" data-i18n="header.lang_label">Idioma</label>
        <div class="pointer-events-none absolute left-2.5 sm:left-3 text-[#4b5563] flex items-center">
          <svg class="w-4 h-4 text-[#111111]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
        </div>
        <select
          id="site-lang-select"
          aria-label="Alterar Idioma do Site"
          class="appearance-none bg-white hover:bg-[#fafafa] border border-[#ebebeb] hover:border-[#111111]/30 text-[#111111] text-xs sm:text-sm font-semibold rounded-full pl-8 sm:pl-9 pr-7 sm:pr-8 py-1.5 sm:py-2 transition-all cursor-pointer shadow-xs focus:outline-none focus:ring-2 focus:ring-[#111111]/15 focus:border-[#111111]"
        >
          <option value="pt" selected>Português (Brasil)</option>
          <option value="en">English (US)</option>
          <option value="es">Español</option>
          <option value="it">Italiano</option>
          <option value="de">Deutsch</option>
          <option value="fr">Français</option>
        </select>
        <div class="pointer-events-none absolute right-2.5 sm:right-3 text-[#6b7280] flex items-center">
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden p-2 rounded-lg text-[#374151] hover:text-[#111111] hover:bg-[#111111]/5 focus:outline-none focus:ring-2 focus:ring-[#111111]/20"
        aria-label="Abrir Menu de Navegação"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg id="menu-icon-bars" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-nav" class="hidden md:hidden border-t border-[#ebebeb] bg-[#fafafa]/95 backdrop-blur-md px-4 py-3 space-y-1">
    {navItems.map((item) => {
      const active = isActive(item);
      return (
        <a
          href={item.href}
          class={`flex items-center min-h-[44px] px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors ${
            active
              ? 'bg-[#111111]/5 text-[#111111] font-semibold'
              : 'text-[#4b5563] hover:text-[#111111] hover:bg-[#111111]/5'
          }`}
          aria-current={active ? 'page' : undefined}
          data-i18n={item.i18nKey}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</header>

<script>
  import { setSiteLanguage, getCurrentSiteLang, applySiteLanguage } from '../utils/i18n';

  // Language Dropdown
  const select = document.getElementById('site-lang-select') as HTMLSelectElement | null;
  if (select) {
    const currentLang = getCurrentSiteLang();
    select.value = currentLang;

    // Apply language on initial page load if saved and different from default 'pt'
    if (currentLang && currentLang !== 'pt') {
      applySiteLanguage(currentLang);
    }

    select.addEventListener('change', (e) => {
      const targetLang = (e.target as HTMLSelectElement).value;
      setSiteLanguage(targetLang);
    });
  }

  // Mobile Menu Toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !mobileNav.classList.contains('hidden');
      if (isOpen) {
        mobileNav.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        iconBars?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      } else {
        mobileNav.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
        iconBars?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
      }
    });
  }
</script>
